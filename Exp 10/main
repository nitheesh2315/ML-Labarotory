"""Student Performance Prediction using Linear Regression."""
from dataset import load_dataset, FEATURE_NAMES
from model import train_model, predict_marks
from plot import save_graph
from utils import get_number, get_category


def main():
    print("=" * 56)
    print("   STUDENT PERFORMANCE PREDICTION USING MACHINE LEARNING")
    print("=" * 56)

    # Step 1: load the sample dataset
    X, y = load_dataset()
    print(f"\n[1] Dataset loaded: {X.shape[0]} students, "
          f"{X.shape[1]} input features")
    print("    Features :", ", ".join(FEATURE_NAMES))

    # Step 2: train and evaluate the model
    print("\n[2] Training Linear Regression model ...")
    model, X_train, X_test, y_test, y_pred, mae, r2 = train_model(X, y)
    print("    Model training completed.")
    print(f"    Training samples : {len(X_train)}")
    print(f"    Testing samples  : {len(X_test)}")

    # Step 3: show evaluation metrics
    print("\n[3] Model evaluation on the test set")
    print(f"    Mean Absolute Error (MAE) : {mae:.2f}")
    print(f"    R2 Score                  : {r2:.4f}")

    # Step 4: save the graph of actual vs predicted marks
    save_graph(X, y, y_test, y_pred, mae, r2, "actual_vs_predicted.png")
    print("\n[4] Graph saved as actual_vs_predicted.png")

    # Step 5: predict for new students entered in the terminal
    while True:
        print("\n[5] Enter the student details")
        hours = get_number(
            "    Study hours per day (0 - 12)   : ", 0, 12)
        attendance = get_number(
            "    Attendance percentage (0 - 100): ", 0, 100)
        previous = get_number(
            "    Previous marks (0 - 100)       : ", 0, 100)

        marks = predict_marks(model, hours, attendance, previous)
        print("\n    ---------- PREDICTION RESULT ----------")
        print(f"    Predicted marks      : {marks:.2f} / 100")
        print(f"    Performance category : {get_category(marks)}")
        print("    ---------------------------------------")

        again = input("\nPredict for another student? (y/n): ")
        again = again.strip().lower()
        if again != "y":
            break

    print("\nThank you. Program finished.")


if __name__ == "__main__":
    main()
